{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aira-os.local/schemas/knowledge_graph/node.schema.json",
  "title": "Knowledge Graph Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "category",
    "layer",
    "tags",
    "createdDate",
    "updatedDate",
    "version",
    "confidence",
    "visibility",
    "owner",
    "references",
    "relatedNodes",
    "scores"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "AI Model", "AI Tool", "Company", "Person", "Research Paper", "Prompt", "Workflow",
        "Automation", "Content", "Conversation", "Decision", "Experiment", "Project", "Task",
        "Business", "Platform", "API", "Framework", "Programming Language", "Database", "Agent",
        "Memory", "Document", "Idea", "Feature", "Release", "Issue", "RFC", "Roadmap Item"
      ]
    },
    "layer": { "type": "integer", "minimum": 1, "maximum": 6 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "createdDate": { "type": "string", "format": "date-time" },
    "updatedDate": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "visibility": { "type": "string", "enum": ["public", "internal", "private", "restricted", "archived"] },
    "owner": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "relatedNodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scores": { "$ref": "#/$defs/scores" },
    "historicalVersions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceType", "citation", "summary", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceType": { "type": "string", "enum": ["document", "url", "conversation", "experiment", "observation", "repository", "manual"] },
        "citation": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedDate": { "type": "string", "format": "date-time" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "importance", "freshness", "popularity", "businessValue", "educationalValue", "completeness"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "type": "number", "minimum": 0, "maximum": 1 },
        "popularity": { "type": "number", "minimum": 0, "maximum": 1 },
        "businessValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "educationalValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
